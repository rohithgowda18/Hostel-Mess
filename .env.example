# =======================================================
# Hostel Dining Platform - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# =======================================================

# 1. Backend Server Port
PORT=8080

# 2. Database Secrets (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostel_mess?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostel_mess?retryWrites=true&w=majority

# 3. Security Secrets (JWT Secret - minimum 32 characters)
JWT_SECRET=your-32-character-secret-key-goes-here
JWT_EXPIRATION=86400000

# 4. Frontend Client Environment Variables
FRONTEND_URL=https://hostel-hub.rohith.app
VITE_API_BASE_URL=http://localhost:8080/api
